---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/data';
---

<Base title="Page not found" noindex>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-display text-8xl font-bold text-saffron-500/30">४०४</p>
    <h1 class="mt-4 font-display text-4xl font-bold text-ivory-50">This scene doesn't exist</h1>
    <p class="mt-3 text-ivory-500">
      The page you're looking for was left on the cutting-room floor. Try searching, or browse the
      catalogue.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="focus-ring rounded-full bg-saffron-500 px-6 py-3 text-sm font-semibold text-ink-950 hover:bg-saffron-400">Back to home</a>
      <a href="/search" class="focus-ring rounded-full border border-ink-500 px-6 py-3 text-sm font-semibold text-ivory-100 hover:border-saffron-500/50">Search {SITE.name}</a>
    </div>
  </section>
</Base>
