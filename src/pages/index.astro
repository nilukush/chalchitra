---
import Base from '../layouts/Base.astro';
import PosterCard from '../components/PosterCard.astro';
import PersonCard from '../components/PersonCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE, stats, recentTitles, upcomingTitles, spotlightPersons, languages, trendingTitles, trendingPersons, liveTrendingCandidates } from '../lib/data';

const latestMovies = recentTitles('movie', 12);
const latestSeries = recentTitles('series', 6);
const soon = upcomingTitles('movie', 5);
const people = spotlightPersons(12);
const topLanguages = languages().slice(0, 10);
const hotTitles = trendingTitles(12);
const hotPeople = trendingPersons(8);
const hasTrends = hotTitles.length > 0;
const liveCandidates = liveTrendingCandidates(350);
---

<Base title={SITE.name}>
  <!-- Hero -->
  <section class="relative grain overflow-hidden border-b border-ink-700/60">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_70%_20%,rgba(244,167,44,0.14),transparent_60%),radial-gradient(40%_40%_at_20%_80%,rgba(227,93,135,0.08),transparent_60%)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-saffron-500">चलचित्र · movies · series · people</p>
      <h1 class="max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ivory-50 sm:text-6xl">
        Every Indian movie<br />
        <span class="italic text-saffron-400">&amp; series has a home.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ivory-300">
        {SITE.name} is the destination for Indian screen — films, series and the people who
        make them, with posters, plots, episode guides, music, reviews and sources. Not an
        afterthought of a global database; the whole point of one.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/movies" class="focus-ring rounded-full bg-saffron-500 px-6 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-saffron-500/20 transition hover:bg-saffron-400">
          Browse {stats.movies} films
        </a>
        <a href="/series" class="focus-ring rounded-full border border-ink-500 px-6 py-3 text-sm font-semibold text-ivory-100 transition hover:border-saffron-500/50 hover:text-saffron-300">
          Explore {stats.series} series debuts
        </a>
        <a href="/search" class="focus-ring rounded-full border border-ink-500 px-6 py-3 text-sm font-semibold text-ivory-100 transition hover:border-saffron-500/50 hover:text-saffron-300">
          Search everything
        </a>
      </div>
      <dl class="mt-12 grid max-w-2xl grid-cols-3 gap-6">
        <div class="border-l-2 border-saffron-500/50 pl-4">
          <dt class="text-xs uppercase tracking-widest text-ivory-600">Films</dt>
          <dd class="font-display text-3xl font-bold text-ivory-50">{stats.movies}</dd>
        </div>
        <div class="border-l-2 border-lotus-500/50 pl-4">
          <dt class="text-xs uppercase tracking-widest text-ivory-600">Series debuts</dt>
          <dd class="font-display text-3xl font-bold text-ivory-50">{stats.series}</dd>
        </div>
        <div class="border-l-2 border-peacock-500/50 pl-4">
          <dt class="text-xs uppercase tracking-widest text-ivory-600">Cast &amp; crew</dt>
          <dd class="font-display text-3xl font-bold text-ivory-50">{stats.persons}</dd>
        </div>
      </dl>
      <p class="mt-6 text-sm text-ivory-600">
        Currently cataloguing {stats.years.join(' · ')} — earlier years and new industries (Korea next) are on the roadmap.
      </p>
    </div>
  </section>

  <!-- Trending -->
  {hasTrends && (
    <section class="border-b border-ink-700/60 bg-gradient-to-b from-saffron-500/[0.06] to-transparent" aria-labelledby="trending">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
        <div class="mb-5 flex items-end justify-between gap-4">
          <div>
            <p class="mb-1 text-xs font-semibold uppercase tracking-[0.2em] text-saffron-500">
              🔥 <span id="trending-mode">Trending this week · <span class="text-ivory-600">by Wikipedia readership</span></span>
            </p>
            <h2 id="trending" class="font-display text-2xl font-bold tracking-tight text-ivory-50 sm:text-3xl">What India is watching</h2>
          </div>
        </div>
        <script type="application/json" id="live-trending-data" set:html={JSON.stringify(liveCandidates)} />
        <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6" id="trending-grid">
          {hotTitles.map((item, i) => (
            <div class="relative">
              <span class="absolute -left-1.5 -top-1.5 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-saffron-500 font-display text-sm font-bold text-ink-950 shadow-lg shadow-black/40" aria-label={`Rank ${i + 1}`}>
                {i + 1}
              </span>
              <PosterCard item={item} eager={i < 6} />
            </div>
          ))}
        </div>

        {hotPeople.length > 0 && (
          <div class="mt-12">
            <h3 class="font-display text-xl font-bold text-ivory-50">Trending people</h3>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {hotPeople.map((person) => <PersonCard person={person} />)}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Latest movies -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6" aria-labelledby="latest-movies">
    <SectionHeading title="Fresh in theatres" kicker="2026 films" href="/movies" linkLabel="All films" />
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {latestMovies.map((item, i) => <PosterCard item={item} eager={i < 6} />)}
    </div>
  </section>

  <!-- Latest series -->
  <section class="border-y border-ink-700/50 bg-ink-900/60" aria-labelledby="latest-series">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <SectionHeading title="New on the small screen" kicker="2026 series debuts" href="/series" linkLabel="All series" />
      <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        {latestSeries.map((item) => <PosterCard item={item} />)}
      </div>
    </div>
  </section>

  <!-- Languages -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6" aria-labelledby="languages">
    <SectionHeading title="Every language, one stage" kicker="Browse by industry" />
    <div class="flex flex-wrap gap-2.5">
      {topLanguages.map((lang) => (
        <a
          href={`/movies?lang=${encodeURIComponent(lang.language)}`}
          class="focus-ring rounded-full border border-ink-600 bg-ink-800 px-5 py-2.5 text-sm font-medium text-ivory-200 transition hover:border-saffron-500/50 hover:bg-ink-700"
        >
          {lang.language}
          <span class="ml-2 text-xs text-ivory-600">{lang.movies + lang.series}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Spotlight people -->
  <section class="border-t border-ink-700/50 bg-ink-900/60" aria-labelledby="spotlight">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <SectionHeading title="The busiest people of 2026" kicker="Spotlight" href="/people" linkLabel="All people" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {people.map((person) => <PersonCard person={person} />)}
      </div>
    </div>
  </section>

  <!-- Coming soon teaser -->
  {soon.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6" aria-labelledby="upcoming">
      <SectionHeading title="On the horizon" kicker="Upcoming · no dates yet" href="/movies" linkLabel="Browse films" />
      <ul class="flex flex-wrap gap-2.5">
        {soon.map((item) => (
          <li>
            <a href={`/movies/${item.slug}`} class="focus-ring inline-block rounded-full border border-dashed border-ink-500 px-4 py-2 text-sm text-ivory-300 transition hover:border-saffron-500/60 hover:text-saffron-300">
              {item.title} <span class="text-ivory-600">· {item.language}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script>
  // Near-real-time trending: intersect the freshest Wikipedia "top viewed per
  // day" data with our catalogue and re-render the titles grid. Static build
  // output stays as the fallback when the API is unreachable.
  interface Candidate { a: string; u: string; t: string; p?: string; l?: string; k: string; y: number; }

  const CACHE_KEY = 'chalachitra-live-trending';
  const CACHE_TTL_MS = 30 * 60 * 1000;

  function cardHtml(c: Candidate, rank: number): string {
    const img = c.p
      ? `<img src="${c.p}" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover">`
      : '<span class="font-display text-3xl text-ivory-600">च</span>';
    return `<div class="relative">
      <span aria-label="Rank ${rank}" class="absolute -left-1.5 -top-1.5 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-saffron-500 font-display text-sm font-bold text-ink-950 shadow-lg shadow-black/40">${rank}</span>
      <a href="${c.u}" class="group block">
        <div class="relative aspect-[2/3] overflow-hidden rounded-xl border border-ink-700/70 bg-ink-800 shadow-lg shadow-black/30 transition duration-300 group-hover:-translate-y-1 group-hover:border-saffron-500/40">
          <div class="flex h-full w-full items-center justify-center">${img}</div>
        </div>
        <h3 class="mt-2.5 line-clamp-2 text-[15px] font-semibold leading-snug text-ivory-100 group-hover:text-saffron-300">${c.t}</h3>
        <p class="text-xs text-ivory-600">${c.l ?? ''} · ${c.k === 'movie' ? 'Film' : 'Series'}</p>
      </a>
    </div>`;
  }

  function apply(candidates: Candidate[], views: Map<string, number>): void {
    const grid = document.getElementById('trending-grid');
    const mode = document.getElementById('trending-mode');
    if (!grid) return;
    const ranked = candidates
      .map((c) => ({ c, v: views.get(c.a) ?? 0 }))
      .filter((x) => x.v > 0)
      .sort((x, y) => y.v - x.v)
      .slice(0, 12);
    if (ranked.length < 4) return;
    grid.innerHTML = ranked.map((x, i) => cardHtml(x.c, i + 1)).join('');
    if (mode) {
      mode.innerHTML = 'Live · Wikipedia readership, latest days <span class="ml-1 inline-block h-2 w-2 animate-pulse rounded-full bg-saffron-400" aria-hidden="true"></span>';
    }
  }

  async function fetchDay(back: number): Promise<Map<string, number> | null> {
    const d = new Date(Date.now() - back * 24 * 3600 * 1000);
    const ymd = `${d.getUTCFullYear()}/${String(d.getUTCMonth() + 1).padStart(2, '0')}/${String(d.getUTCDate()).padStart(2, '0')}`;
    try {
      const res = await fetch(
        `https://wikimedia.org/api/rest_v1/metrics/pageviews/top/en.wikipedia/all-access/${ymd}`,
        { headers: { Accept: 'application/json' } },
      );
      if (!res.ok) return null;
      const json = await res.json();
      const map = new Map<string, number>();
      for (const a of json.items?.[0]?.articles ?? []) map.set(a.article, a.views);
      return map.size > 0 ? map : null;
    } catch {
      return null;
    }
  }

  async function run(): Promise<void> {
    const dataEl = document.getElementById('live-trending-data');
    if (!dataEl) return;
    let candidates: Candidate[] = [];
    try {
      candidates = JSON.parse(dataEl.textContent ?? '[]');
    } catch {
      return;
    }
    if (candidates.length === 0) return;

    // cached render → instant, polite (≤1 fetch per visitor per half hour)
    try {
      const cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) ?? 'null');
      if (cached && Date.now() - cached.at < CACHE_TTL_MS) {
        apply(candidates, new Map(cached.views));
        return;
      }
    } catch {
      /* ignore */
    }

    const views = new Map<string, number>();
    let got = 0;
    for (const back of [1, 2, 3, 4, 5]) {
      const day = await fetchDay(back);
      if (!day) continue;
      got++;
      for (const [article, v] of day) views.set(article, (views.get(article) ?? 0) + v);
      if (got >= 3) break;
    }
    if (got === 0) return; // keep static build-time list
    apply(candidates, views);
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), views: [...views.entries()].slice(0, 800) }));
    } catch {
      /* quota — ignore */
    }
  }

  run();
</script>
