---
import Base from '../../layouts/Base.astro';
import Pagination from '../../components/Pagination.astro';
import PosterCard from '../../components/PosterCard.astro';
import { movies, indexLanguages, indexPage, sortForIndex, SITE } from '../../lib/data';

const sorted = sortForIndex(movies);
const page = indexPage(sorted, 1);
const movieLanguages = indexLanguages('movie');
const yearRange = page.items.length > 0 ? `${sorted[sorted.length - 1].year}–${sorted[0].year}` : '';
---

<Base
  title={`Indian Movies — ${movies.length} films`}
  description={`Every Indian film on ${SITE.name} — ${movies.length} films from ${yearRange || 'classic to current'} across Hindi, Tamil, Telugu, Malayalam, Kannada and more, with posters, plots, cast and credits.`}
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-saffron-500">Feature films</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ivory-50">Indian movies</h1>
    <p class="mt-3 max-w-2xl text-ivory-500">
      {movies.length} films across India's industries and eras — from Bollywood blockbusters to
      regional independents. Filter by language, or open any film for its full picture: plot,
      cast, crew, release and reception.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by language">
      <a href="/movies" class="focus-ring rounded-full border border-saffron-500/60 bg-saffron-500/10 px-4 py-1.5 text-sm font-medium text-saffron-300" aria-current="page">
        All <span class="text-xs opacity-70">{movies.length}</span>
      </a>
      {movieLanguages.map((lang) => (
        <a href={`/movies/lang/${lang.language.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="focus-ring rounded-full border border-ink-600 bg-ink-800 px-4 py-1.5 text-sm font-medium text-ivory-300 transition hover:border-saffron-500/40">
          {lang.language} <span class="text-xs text-ivory-600">{lang.count}</span>
        </a>
      ))}
    </div>

    <p class="mt-6 text-sm text-ivory-600">
      Showing {page.items.length} of {page.total} films{page.pages > 1 ? ` · page 1 of ${page.pages}` : ''}
    </p>

    <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {page.items.map((item, i) => (
        <PosterCard item={item} eager={i < 6} />
      ))}
    </div>

    <Pagination base="/movies" pageNo={page.pageNo} pages={page.pages} />
  </section>
</Base>
