---
import TitleDetail from '../../components/TitleDetail.astro';
import { fullTitle, movies } from '../../lib/data';

export function getStaticPaths() {
  return movies.map((movie) => ({ params: { slug: movie.slug } }));
}

const movie = await fullTitle('movie', Astro.params.slug!);
---

{movie && <TitleDetail item={movie} />}
