---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ExternalLinks from '../../components/ExternalLinks.astro';
import JsonLd from '../../components/JsonLd.astro';
import PosterCard from '../../components/PosterCard.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import { SITE, persons, personInitials, getTitleBySlug, titles, imdbNameUrl } from '../../lib/data';
import { computeAgeFromFacts } from '../../lib/dates';
import { splitLongParagraphs } from '../../lib/format';

export function getStaticPaths() {
  return persons.map((person) => ({ params: { slug: person.slug }, props: { person } }));
}

const { person } = Astro.props;
const canonical = new URL(`/people/${person.slug}`, SITE.url).href;
const filmographyInCatalogue = (person.filmography ?? [])
  .map((work) => ({ work, title: titles.find((t) => t.wikiTitle === work.wikiTitle) }))
  .filter((e) => e.title !== undefined) as { work: { title: string; wikiTitle: string }; title: NonNullable<ReturnType<typeof getTitleBySlug>> }[];

const description =
  (person.summary ?? `${person.name} — credits and facts on ${SITE.name}.`).slice(0, 300).trim() + '…';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: person.name,
    url: canonical,
    image: person.image,
    description: (person.summary ?? '').slice(0, 500),
    jobTitle: person.occupations[0],
    hasOccupation: person.occupations.map((o) => ({ '@type': 'Occupation', name: o })),
    sameAs: [
      person.wikiUrl,
      ...(person.external.imdbId ? [`https://www.imdb.com/name/nm${person.external.imdbId}/`] : []),
    ].filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'People', item: new URL('/people', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: person.name, item: canonical },
    ],
  },
];

const age = computeAgeFromFacts(person.facts);
const diedFact = person.facts.find((f) => f.label === 'Died');
const yearsActive = person.facts.find((f) => f.label === 'Years active')?.value;

const creditTitleRecords = person.credits
  .map((credit) => ({ credit, title: getTitleBySlug(credit.titleSlug, credit.kind) }))
  .filter((entry) => entry.title !== undefined);
---

<Base title={person.name} description={description} image={person.image} type="article">
  <JsonLd data={jsonLd} />

  <article class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <Breadcrumbs crumbs={[{ label: 'People', href: '/people' }, { label: person.name }]} />

    <div class="grid gap-10 lg:grid-cols-[280px_1fr]">
      <div class="lg:sticky lg:top-20 lg:self-start">
        {person.image ? (
          <img
            src={person.image}
            alt={`Portrait of ${person.name}`}
            width="480"
            height="480"
            class="w-full rounded-2xl border border-ink-700 object-cover shadow-2xl shadow-black/40"
          />
        ) : (
          <div class="flex aspect-square w-full items-center justify-center rounded-2xl border border-ink-700 bg-ink-800 grain">
            <span class="font-display text-7xl text-ivory-600">{personInitials(person.name)}</span>
          </div>
        )}

        <!-- quick actions: profiles first, not buried at the bottom -->
        <div class="mt-4 grid grid-cols-2 gap-2">
          {person.external.imdbId && (
            <a href={imdbNameUrl(person.external.imdbId)} rel="noopener" class="focus-ring flex items-center justify-center gap-1.5 rounded-xl border border-ink-600 bg-ink-800 px-3 py-2 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
              IMDb ↗
            </a>
          )}
          {person.tmdbId && (
            <a href={`https://www.themoviedb.org/person/${person.tmdbId}`} rel="noopener" class="focus-ring flex items-center justify-center gap-1.5 rounded-xl border border-ink-600 bg-ink-800 px-3 py-2 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
              TMDB ↗
            </a>
          )}
          <a href={person.wikiUrl} rel="noopener" class="focus-ring flex items-center justify-center gap-1.5 rounded-xl border border-ink-600 bg-ink-800 px-3 py-2 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
            Wikipedia ↗
          </a>
          {person.external.links.filter((l) =>/instagram|facebook|twitter|x\.com|youtube|spotify|bollywood/i.test(l.url + l.label)).slice(0, 1).map((l) => (
            <a href={l.url} rel="noopener" class="focus-ring col-span-2 flex items-center justify-center gap-1.5 rounded-xl border border-ink-600 bg-ink-800 px-3 py-2 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
              {l.label} ↗
            </a>
          ))}
        </div>

        <!-- quick stats -->
        <div class={`grid gap-2 text-center ${age !== null ? 'grid-cols-2' : 'grid-cols-1'}`}>
          <div class="rounded-xl border border-ink-700/70 bg-ink-850/70 px-2 py-3">
            <p class="font-display text-2xl font-bold text-saffron-400">{person.credits.length}</p>
            <p class="text-[10px] font-semibold uppercase tracking-widest text-ivory-600">Credits</p>
          </div>
          {age !== null && (
            <div class="rounded-xl border border-ink-700/70 bg-ink-850/70 px-2 py-3">
              <p class="font-display text-2xl font-bold text-saffron-400">{age}</p>
              <p class="text-[10px] font-semibold uppercase tracking-widest text-ivory-600">{diedFact ? 'age at death' : 'years old'}</p>
            </div>
          )}
        </div>

        {person.facts.filter((f) => f.label !== 'Years active').length > 0 && (
          <dl class="mt-5 space-y-2.5 text-sm">
            {person.facts.filter((f) => f.label !== 'Years active').map((fact) => (
              <div class="border-b border-ink-700/40 pb-2.5">
                <dt class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ivory-600">{fact.label}</dt>
                <dd class="mt-1 leading-snug text-ivory-100">{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div>
        {person.occupations.length > 0 && (
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-saffron-500">
            {person.occupations.slice(0, 3).join(' · ')}{yearsActive && <span class="ml-2 font-normal normal-case tracking-normal text-ivory-500">Active {yearsActive}</span>}
          </p>
        )}
        <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ivory-50 sm:text-5xl">{person.name}</h1>

        {person.summary && (
          <div class="prose-article mt-6 max-w-3xl">
            {person.summary.split('\n').filter(Boolean).flatMap((para) => splitLongParagraphs(para)).map((para) => <p>{para}</p>)}
          </div>
        )}

        {person.knownFor && person.knownFor.length > 0 && (
          <section class="mt-10" aria-labelledby="known-for">
            <h2 id="known-for" class="font-display text-2xl font-bold text-ivory-50">Known for</h2>
            <p class="mt-1 text-xs text-ivory-600">Notable works beyond our current catalogue · via TMDB</p>
            <div class="mt-4 flex gap-4 overflow-x-auto pb-3 [scrollbar-width:thin]">
              {person.knownFor.map((work) => (
                <a href={work.url} rel="noopener" class="focus-ring group w-32 shrink-0">
                  <div class="aspect-[2/3] overflow-hidden rounded-xl border border-ink-700/70 bg-ink-800 shadow-lg shadow-black/30 transition group-hover:border-saffron-500/40">
                    {work.poster ? (
                      <img src={work.poster} alt={work.title} loading="lazy" width="185" height="278" class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full items-center justify-center grain"><span class="font-display text-2xl text-ivory-600">च</span></div>
                    )}
                  </div>
                  <p class="mt-2 line-clamp-2 text-sm font-semibold leading-snug text-ivory-100 group-hover:text-saffron-300">{work.title}</p>
                  <p class="text-xs text-ivory-600">{work.year ?? ''} · {work.kind === 'movie' ? 'Film' : 'Series'}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="mt-10" aria-labelledby="credits">
          <h2 id="credits" class="font-display text-2xl font-bold text-ivory-50">
            2026 credits <span class="text-lg text-ivory-600">({person.credits.length})</span>
          </h2>
          {person.credits.length > 0 ? (
            <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
              {creditTitleRecords.map(({ title }) => <PosterCard item={title} />)}
            </div>
          ) : (
            <p class="mt-4 text-ivory-500">No 2026 titles recorded yet.</p>
          )}
          <ul class="mt-6 space-y-1.5 text-sm text-ivory-500">
            {person.credits.slice(0, 30).map((credit) => (
              <li class="flex items-baseline gap-2">
                <span class="shrink-0 rounded bg-ink-800 px-1.5 py-0.5 text-[10px] font-semibold text-ivory-400">{credit.year}</span>
                <a href={credit.kind === 'movie' ? `/movies/${credit.titleSlug}` : `/series/${credit.titleSlug}`} class="text-ivory-300 hover:text-saffron-300">
                  {credit.title}
                </a>
                <span class="text-ivory-600">— {credit.role}</span>
              </li>
            ))}
          </ul>
        </section>

        {(person.filmography?.length ?? 0) > 0 && (
          <section class="mt-10" aria-labelledby="filmography">
            <h2 id="filmography" class="font-display text-2xl font-bold text-ivory-50">
              From the Wikipedia filmography <span class="text-lg text-ivory-600">({person.filmography!.length} works)</span>
            </h2>
            {filmographyInCatalogue.length > 0 ? (
              <>
                <p class="mt-2 text-sm text-ivory-500">
                  {filmographyInCatalogue.length} of these works are in our catalogue — jump straight in:
                </p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {filmographyInCatalogue.slice(0, 24).map(({ work, title }) => (
                    <li>
                      <a href={title!.kind === 'movie' ? `/movies/${title!.slug}` : `/series/${title!.slug}`} class="focus-ring inline-block rounded-full border border-ink-600 bg-ink-800 px-4 py-1.5 text-sm text-ivory-300 transition hover:border-saffron-500/50 hover:text-saffron-300">
                        {work.title} {title!.year ? <span class="text-ivory-600">· {title!.year}</span> : ''}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <p class="mt-2 text-sm text-ivory-500">
                {person.filmography!.length} linked works across film, television and music — browse the full list on Wikipedia.
              </p>
            )}
          </section>
        )}

        {person.references.length > 0 && (
          <section class="mt-10" aria-labelledby="references">
            <h2 id="references" class="font-display text-2xl font-bold text-ivory-50">
              Sources &amp; references <span class="text-lg text-ivory-600">({person.references.length})</span>
            </h2>
            <p class="mt-2 text-sm text-ivory-500">
              The biographical facts above trace to these cited sources.
            </p>
            <div class="mt-4">
              <ReferenceList references={person.references} />
            </div>
          </section>
        )}

        {person.sections.length > 0 && (
          <section class="mt-10" aria-labelledby="article">
            <h2 id="article" class="font-display text-2xl font-bold text-ivory-50">On the Wikipedia article</h2>
            <p class="mt-3 text-sm text-ivory-500">
              The biographical article covers: {person.sections.join(' · ')}
            </p>
          </section>
        )}

        <section class="mt-10 border-t border-ink-700/60 pt-6" aria-labelledby="links">
          <h2 id="links" class="sr-only">External links</h2>
          <ExternalLinks
            imdbId={person.external.imdbId}
            official={person.external.official}
            links={person.external.links}
            wikiUrl={person.wikiUrl}
            kind="person"
          />
        </section>
      </div>
    </div>
  </article>
</Base>
