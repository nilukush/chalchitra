---
import Base from '../../layouts/Base.astro';
import Pagination from '../../components/Pagination.astro';
import PersonCard from '../../components/PersonCard.astro';
import { INDEX_PAGE_SIZE, SITE, personsSorted } from '../../lib/data';

export async function getStaticPaths() {
  return [{ params: {}, props: { pageNo: 1 } }];
}

const { pageNo } = Astro.props;
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ#'.split('');

/** paginate the alphabetical list, then re-bucket THIS page's slice by letter */
const total = personsSorted.length;
const pages = Math.max(1, Math.ceil(total / INDEX_PAGE_SIZE));
const slice = personsSorted.slice((pageNo - 1) * INDEX_PAGE_SIZE, pageNo * INDEX_PAGE_SIZE);
const byLetter = new Map<string, typeof slice>();
for (const letter of letters) byLetter.set(letter, []);
for (const person of slice) {
  const first = person.name[0]?.toUpperCase() ?? '#';
  const key = /[A-Z]/.test(first) ? first : '#';
  byLetter.get(key)!.push(person);
}
const activeLetters = letters.filter((l) => (byLetter.get(l) ?? []).length > 0);
---

<Base
  title={`Cast & Crew of Indian Cinema — ${total} people`}
  description={`Every actor, director, writer, musician and technician behind Indian movies and series — ${total} people with bios, facts and full credits on ${SITE.name}.`}
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-peacock-400">People</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ivory-50">The people of Indian cinema</h1>
    <p class="mt-3 max-w-2xl text-ivory-500">
      {total} actors, directors, writers, composers and technicians — each with their
      biography, filmography, awards and external profiles.
    </p>

    <nav class="mt-8 flex flex-wrap gap-1.5" aria-label="Jump to letter">
      {activeLetters.map((letter) => (
        <a
          href={`#letter-${letter === '#' ? 'hash' : letter}`}
          class="focus-ring rounded-md border border-ink-700 bg-ink-800 px-3 py-1 text-sm font-medium text-ivory-300 hover:border-saffron-500/40 hover:text-saffron-300"
        >
          {letter}
        </a>
      ))}
    </nav>

    <p class="mt-6 text-sm text-ivory-600">
      Showing {slice.length} of {total} people{pages > 1 ? ` · page ${pageNo} of ${pages}` : ''}
    </p>

    {activeLetters.map((letter) => (
      <section class="mt-10" aria-labelledby={`letter-${letter === '#' ? 'hash' : letter}`}>
        <h2 id={`letter-${letter === '#' ? 'hash' : letter}`} class="font-display text-2xl font-bold text-saffron-400">
          {letter === '#' ? 'Other' : letter}
        </h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {(byLetter.get(letter) ?? []).map((person) => <PersonCard person={person} />)}
        </div>
      </section>
    ))}

    <Pagination base="/people" pageNo={pageNo} pages={pages} />
  </section>
</Base>
