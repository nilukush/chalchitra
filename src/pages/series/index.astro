---
import Base from '../../layouts/Base.astro';
import Pagination from '../../components/Pagination.astro';
import PosterCard from '../../components/PosterCard.astro';
import { series, indexLanguages, indexPage, sortForIndex, SITE } from '../../lib/data';

const sorted = sortForIndex(series);
const page = indexPage(sorted, 1);
const seriesLanguages = indexLanguages('series');
---

<Base
  title={`Indian Television & Streaming Series — ${series.length} shows`}
  description={`Indian TV and streaming series on ${SITE.name} — ${series.length} shows across languages, platforms and decades, with casts, plots and credits.`}
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-lotus-400">Television &amp; streaming</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ivory-50">Indian series</h1>
    <p class="mt-3 max-w-2xl text-ivory-500">
      {series.length} shows — weekday dramas, OTT originals and reality formats across India's
      languages and eras. Filter by language, or open any series for its full picture.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by language">
      <a href="/series" class="focus-ring rounded-full border border-saffron-500/60 bg-saffron-500/10 px-4 py-1.5 text-sm font-medium text-saffron-300" aria-current="page">
        All <span class="text-xs opacity-70">{series.length}</span>
      </a>
      {seriesLanguages.map((lang) => (
        <a href={`/series/lang/${lang.language.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="focus-ring rounded-full border border-ink-600 bg-ink-800 px-4 py-1.5 text-sm font-medium text-ivory-300 transition hover:border-saffron-500/40">
          {lang.language} <span class="text-xs text-ivory-600">{lang.count}</span>
        </a>
      ))}
    </div>

    <p class="mt-6 text-sm text-ivory-600">
      Showing {page.items.length} of {page.total} series{page.pages > 1 ? ` · page 1 of ${page.pages}` : ''}
    </p>

    <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {page.items.map((item, i) => (
        <PosterCard item={item} eager={i < 6} />
      ))}
    </div>

    <Pagination base="/series" pageNo={page.pageNo} pages={page.pages} />
  </section>
</Base>
