---
import TitleDetail from '../../components/TitleDetail.astro';
import { fullTitle, series } from '../../lib/data';

export function getStaticPaths() {
  return series.map((show) => ({ params: { slug: show.slug } }));
}

const show = await fullTitle('series', Astro.params.slug!);
---

{show && <TitleDetail item={show} />}
