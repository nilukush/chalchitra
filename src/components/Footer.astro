---
import { SITE, stats } from '../lib/data';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-700/60 bg-ink-900">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-xl font-bold text-ivory-50">{SITE.name} <span class="text-ivory-500" lang="hi">{SITE.devanagari}</span></p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-ivory-500">{SITE.tagline}. Currently tracking {stats.movies} movies, {stats.series} series and {stats.persons} people from the class of 2026.</p>
    </div>
    <nav aria-label="Footer" class="text-sm">
      <p class="mb-3 font-semibold uppercase tracking-widest text-ivory-600">Explore</p>
      <ul class="space-y-2 text-ivory-300">
        <li><a class="hover:text-saffron-400" href="/movies">Movies{stats.years.length > 0 ? ` of ${stats.years.join(' & ')}` : ''}</a></li>
        <li><a class="hover:text-saffron-400" href="/series">Series debuts{stats.years.length > 0 ? ` of ${stats.years.join(' & ')}` : ''}</a></li>
        <li><a class="hover:text-saffron-400" href="/people">Cast &amp; crew</a></li>
        <li><a class="hover:text-saffron-400" href="/search">Search</a></li>
        <li><a class="hover:text-saffron-400" href="/about">About &amp; data sources</a></li>
      </ul>
    </nav>
    <div class="text-sm">
      <p class="mb-3 font-semibold uppercase tracking-widest text-ivory-600">Data &amp; licensing</p>
      <p class="leading-relaxed text-ivory-500">
        Article text, metadata and images are derived from
        <a class="text-ivory-300 underline decoration-ink-500 hover:text-saffron-400" href="https://en.wikipedia.org" rel="noopener">Wikipedia</a>,
        licensed under <a class="text-ivory-300 underline decoration-ink-500 hover:text-saffron-400" href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener">CC BY-SA 4.0</a>.
        Each page links to its source article. Posters remain hosted by Wikimedia and are used for identification.
      </p>
    </div>
  </div>
  <div class="border-t border-ink-700/40 py-4 text-center text-xs text-ivory-600">
    © {year} {SITE.name} · Built with open knowledge · <a class="hover:text-saffron-400" href="/llms.txt">llms.txt</a>
  </div>
</footer>
