---
import type { TitleRecord } from '../../pipeline/types';
import Breadcrumbs from './Breadcrumbs.astro';
import EpisodesTable from './EpisodesTable.astro';
import ExternalLinks from './ExternalLinks.astro';
import Icon from './Icon.astro';
import JsonLd from './JsonLd.astro';
import PersonCard from './PersonCard.astro';
import ReferenceList from './ReferenceList.astro';
import StatTiles from './StatTiles.astro';
import TrackList from './TrackList.astro';
import Base from '../layouts/Base.astro';
import { SITE, getPersonBySlug, genreChipClass, languageBadgeClass, imdbTitleUrl, titles } from '../lib/data';

const { item }: { item: TitleRecord } = Astro.props;

const indexHref = item.kind === 'movie' ? '/movies' : '/series';
const indexLabel = item.kind === 'movie' ? 'Movies' : 'Series';
const kindWord = item.kind === 'movie' ? 'Film' : 'Series';
const base = item.kind === 'movie' ? `/movies/${item.slug}` : `/series/${item.slug}`;
const canonical = new URL(base, SITE.url).href;

const castPeople = item.cast
  .map((member) => ({ member, person: member.slug ? getPersonBySlug(member.slug) : undefined }))
  .slice(0, 24);

const crew = item.crew.slice(0, 18);

const facts: { label: string; value: string }[] = [
  { label: 'Original title', value: item.nativeName ?? '' },
  { label: 'Directed by', value: item.directedBy.join(', ') },
  { label: 'Created by', value: item.createdBy.join(', ') },
  { label: 'Written by', value: item.writtenBy.join(', ') },
  { label: 'Starring', value: item.cast.slice(0, 6).map((c) => c.name).join(', ') },
  { label: 'Music', value: item.musicBy.join(', ') },
  { label: 'Cinematography', value: item.cinematographyBy.join(', ') },
  { label: 'Editing', value: item.editedBy.join(', ') },
  { label: 'Produced by', value: item.producedBy.join(', ') },
  { label: 'Production', value: item.studios.join(', ') },
  { label: 'Distributed by', value: item.distributor.join(', ') },
  { label: 'Network', value: item.network.join(', ') },
  { label: item.kind === 'movie' ? 'Release date' : 'First aired', value: item.releaseDate ?? '' },
  { label: 'Last aired', value: item.lastAired ?? '' },
  { label: 'Seasons', value: item.seasons ?? '' },
  { label: 'Episodes', value: item.episodes ?? '' },
  { label: 'Runtime', value: item.runtime ?? '' },
  { label: 'Language', value: item.language },
  { label: 'Budget', value: item.budget ?? '' },
  { label: 'Box office', value: item.gross ?? '' },
  { label: 'Genres', value: item.genres.join(', ') },
].filter((f) => f.value.length > 0);

// internal links for related titles that exist in our catalogue
const relatedRecords = (item.relatedTitles ?? [])
  .map((name) => titles.find((t) => t.title.toLowerCase() === name.toLowerCase() && t.slug !== item.slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t))
  .slice(0, 6);

const plotParagraphs = (item.plotHtml ?? item.plot ?? '').split('\n').filter(Boolean);

// facts as visual stat tiles — specs only; people live in "Cast & crew" (no duplication)
const PEOPLE_FACTS = new Set([
  'Starring', 'Directed by', 'Created by', 'Written by', 'Produced by',
  'Music', 'Cinematography', 'Editing',
]);
const TILE_ICONS: Record<string, Parameters<typeof Icon>[0]['name']> = {
  'Original title': 'pen',
  'Directed by': 'clapperboard',
  'Created by': 'clapperboard',
  'Written by': 'pen',
  'Starring': 'users',
  'Music': 'music',
  'Cinematography': 'camera',
  'Editing': 'film',
  'Produced by': 'users',
  'Production': 'film',
  'Distributed by': 'ticket',
  'Network': 'tv',
  'Release date': 'calendar',
  'First aired': 'calendar',
  'Last aired': 'calendar',
  'Seasons': 'tv',
  'Episodes': 'tv',
  'Runtime': 'clock',
  'Language': 'globe',
  'Budget': 'rupee',
  'Box office': 'chart',
  'Genres': 'star',
};
const BIG_TILES = new Set(['Release date', 'First aired', 'Runtime', 'Box office', 'Budget', 'Episodes', 'Seasons']);
const statTiles = facts
  .filter((f) => !PEOPLE_FACTS.has(f.label))
  .map((f) => ({
    icon: TILE_ICONS[f.label] ?? 'link',
    label: f.label,
    value: f.value,
    big: BIG_TILES.has(f.label) && f.value.length <= 22,
  }));

// in-page navigation for the long editorial page
const navItems = [
  plotParagraphs.length > 0 && { href: '#plot', label: item.kind === 'movie' ? 'Plot' : 'Premise', icon: 'pen' as const },
  item.kind === 'series' && item.episodesList.length > 0 && { href: '#episodes', label: 'Episodes', icon: 'tv' as const },
  item.soundtrack && item.soundtrack.tracks.length > 0 && { href: '#soundtrack', label: 'Music', icon: 'music' as const },
  (castPeople.length > 0 || crew.length > 0) && { href: '#cast', label: 'Cast & crew', icon: 'users' as const },
  statTiles.length > 0 && { href: '#facts', label: 'Details', icon: 'clapperboard' as const },
  ...item.articleSections.slice(0, 4).map((s) => ({ href: `#sec-${s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`, label: s.title, icon: 'film' as const })),
  item.references.length > 0 && { href: '#references', label: 'Sources', icon: 'award' as const },
].filter(Boolean) as { href: string; label: string; icon: Parameters<typeof Icon>[0]['name'] }[];

const description =
  (item.plot ?? item.summary ?? `${item.title} is a ${item.year} Indian ${item.language} ${kindWord.toLowerCase()}.`)
    .slice(0, 300)
    .trim() + '…';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': item.kind === 'movie' ? 'Movie' : 'TVSeries',
    name: item.title,
    url: canonical,
    datePublished: item.releaseDate,
    inLanguage: item.language,
    image: item.poster,
    description: (item.plot ?? item.summary ?? '').slice(0, 500),
    genre: item.genres,
    countryOfOrigin: { '@type': 'Country', name: 'India' },
    ...(item.kind === 'movie'
      ? { director: item.directedBy.map((n) => ({ '@type': 'Person', name: n })) }
      : { creator: item.createdBy.map((n) => ({ '@type': 'Person', name: n })) }),
    actor: item.cast.slice(0, 15).map((c) => ({ '@type': 'Person', name: c.name })),
    ...(item.kind === 'series' && item.episodes ? { numberOfEpisodes: Number(item.episodes) || undefined } : {}),
    sameAs: [
      item.wikiUrl,
      ...(item.external.imdbId
        ? [`https://www.imdb.com/title/tt${item.external.imdbId}/`]
        : []),
    ].filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: indexLabel, item: new URL(indexHref, SITE.url).href },
      { '@type': 'ListItem', position: 3, name: item.title, item: canonical },
    ],
  },
];
---

<Base title={`${item.title} (${item.year})`} description={description} image={item.poster} type="article">
  <JsonLd data={jsonLd} />

  <article class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <Breadcrumbs crumbs={[{ label: indexLabel, href: indexHref }, { label: item.title }]} />

    <div class="grid gap-8 lg:grid-cols-[300px_1fr]">
      <!-- Poster column: sticky, with quick actions so the pane is never dead space -->
      <div>
        <div class="lg:sticky lg:top-20 lg:self-start">
          <div class="overflow-hidden rounded-2xl border border-ink-700 bg-ink-800 shadow-2xl shadow-black/40">
            {item.poster ? (
              <img src={item.poster} alt={`${item.title} poster`} width="480" height="720" class="w-full object-cover" />
            ) : (
              <div class="flex aspect-[2/3] items-center justify-center grain">
                <span class="font-display text-6xl text-ivory-600">च</span>
              </div>
            )}
          </div>

          <div class="mt-4 grid grid-cols-2 gap-2">
            {item.trailer && (
              <a href={item.trailer} rel="noopener" class="focus-ring col-span-2 flex items-center justify-center gap-2 rounded-xl bg-saffron-500 px-4 py-2.5 text-sm font-semibold text-ink-950 shadow-lg shadow-saffron-500/20 transition hover:bg-saffron-400">
                <Icon name="film" class="h-4 w-4" /> Watch trailer
              </a>
            )}
            {item.external.imdbId && (
              <a href={imdbTitleUrl(item.external.imdbId)} rel="noopener" class="focus-ring flex items-center justify-center gap-1.5 rounded-xl border border-ink-600 bg-ink-800 px-3 py-2 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
                IMDb ↗
              </a>
            )}
            <a href={item.wikiUrl} rel="noopener" class="focus-ring flex items-center justify-center gap-1.5 rounded-xl border border-ink-600 bg-ink-800 px-3 py-2 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
              Wikipedia ↗
            </a>
            {item.external.official && (
              <a href={item.external.official} rel="noopener" class="focus-ring col-span-2 flex items-center justify-center gap-1.5 rounded-xl border border-ink-600 bg-ink-800 px-3 py-2 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
                Official website ↗
              </a>
            )}
          </div>

          {item.rating && (
            <div class="mt-3 flex items-center justify-between rounded-xl border border-ink-700/70 bg-ink-850/70 px-4 py-3">
              <span class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-ivory-600">
                <Icon name="star" class="h-4 w-4 text-saffron-400" /> TMDB score
              </span>
              <span class="font-display text-2xl font-bold text-saffron-300">{item.rating.value.toFixed(1)}</span>
            </div>
          )}

          {item.external.links.length > 0 && (
            <div class="mt-4 space-y-1.5 text-sm">
              <p class="text-xs font-semibold uppercase tracking-widest text-ivory-600">Elsewhere</p>
              {item.external.links.slice(0, 6).map((link) => (
                <a href={link.url} rel="noopener" class="focus-ring block truncate text-ivory-400 hover:text-saffron-300">
                  {link.label} ↗
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Main column -->
      <div>
        <!-- Title band: identity at a glance, no prose. Plot is the hero content below. -->
        <div class="relative -mx-4 overflow-hidden border-b border-ink-700/60 px-4 pb-8 pt-2 sm:-mx-6 sm:px-6">
          {item.backdrop && (
            <img src={item.backdrop} alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-25" loading="eager" />
          )}
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink-950/40 via-ink-950/80 to-ink-950"></div>
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_75%_10%,rgba(244,167,44,0.12),transparent_65%)]"></div>

          <div class="relative">
            <div class="flex flex-wrap items-center gap-2">
              <span class={`rounded-full px-3 py-1 text-xs font-medium ring-1 ring-inset ${languageBadgeClass(item.language)}`}>{item.language}</span>
              <span class="rounded-full bg-ink-700 px-3 py-1 text-xs font-medium text-ivory-300 ring-1 ring-inset ring-ink-600">{kindWord}</span>
              {item.releaseDate && (
                <span class="rounded-full bg-ink-700 px-3 py-1 text-xs font-medium text-ivory-300 ring-1 ring-inset ring-ink-600">{item.releaseDate}</span>
              )}
              {item.runtime && (
                <span class="rounded-full bg-ink-700 px-3 py-1 text-xs font-medium text-ivory-300 ring-1 ring-inset ring-ink-600">{item.runtime}</span>
              )}
              {item.kind === 'series' && item.episodes && (
                <span class="rounded-full bg-ink-700 px-3 py-1 text-xs font-medium text-ivory-300 ring-1 ring-inset ring-ink-600">{item.episodes} episodes</span>
              )}
            </div>

            <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-ivory-50 sm:text-5xl [text-wrap:balance]">{item.title}</h1>
            {item.nativeName && <p class="mt-1 text-lg text-ivory-400" lang="hi">{item.nativeName}</p>}

            {item.tagline && (
              <p class="mt-3 max-w-xl font-display text-lg italic leading-snug text-saffron-300/90">{item.tagline}</p>
            )}

            {item.genres.length > 0 && (
              <div class="mt-4 flex flex-wrap items-center gap-2">
                {item.genres.map((genre) => (
                  <span class={`rounded-full px-3.5 py-1.5 text-sm font-semibold ring-1 ring-inset ${genreChipClass(genre)}`}>
                    {genre}
                  </span>
                ))}
              </div>
            )}

            <p class="mt-3 text-sm text-ivory-500">
              {item.year} · {item.language} {kindWord.toLowerCase()}
              {item.directedBy.length > 0 && ` · Directed by ${item.directedBy.slice(0, 2).join(', ')}`}
            </p>
          </div>
        </div>

        <!-- sticky in-page nav -->
        {navItems.length > 1 && (
          <nav aria-label="On this page" class="sticky top-[64px] z-30 -mx-4 mt-6 border-b border-ink-700/50 bg-ink-950/90 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6">
            <ul class="flex gap-1.5 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {navItems.map((nav) => (
                <li class="shrink-0">
                  <a href={nav.href} class="focus-ring flex items-center gap-1.5 rounded-full border border-ink-700 bg-ink-800/80 px-3 py-1 text-xs font-medium text-ivory-300 transition hover:border-saffron-500/50 hover:text-saffron-300">
                    <Icon name={nav.icon} class="h-3.5 w-3.5" />
                    {nav.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {plotParagraphs.length > 0 && (
          <section class="mt-10" aria-labelledby="plot">
            <h2 id="plot" class="font-display text-2xl font-bold text-ivory-50">{item.kind === 'movie' ? 'Full plot' : 'Premise'}</h2>
            <div class="prose-article prose-hero mt-4 max-w-3xl">
              {plotParagraphs.map((para) =>
                item.plotHtml ? <p set:html={para} /> : <p>{para}</p>,
              )}
            </div>
          </section>
        )}

        {item.kind === 'series' && item.episodesList.length > 0 && (
          <section class="mt-10" aria-labelledby="episodes">
            <h2 id="episodes" class="font-display text-2xl font-bold text-ivory-50">
              Episode guide <span class="text-lg text-ivory-600">({item.episodesList.length})</span>
            </h2>
            <div class="mt-4">
              <EpisodesTable episodes={item.episodesList} />
            </div>
          </section>
        )}

        {item.soundtrack && item.soundtrack.tracks.length > 0 && (
          <section class="mt-10" aria-labelledby="soundtrack">
            <h2 id="soundtrack" class="font-display text-2xl font-bold text-ivory-50">
              Soundtrack <span class="text-lg text-ivory-600">({item.soundtrack.tracks.length} tracks)</span>
            </h2>
            <div class="mt-4">
              <TrackList soundtrack={item.soundtrack} />
            </div>
          </section>
        )}

        {(castPeople.length > 0 || crew.length > 0) && (
          <section class="mt-10" aria-labelledby="cast">
            <h2 id="cast" class="font-display text-2xl font-bold text-ivory-50">Cast &amp; crew</h2>
            {castPeople.length > 0 && (
              <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                {castPeople.map(({ member, person }) => (
                  <div>
                    {person ? (
                      <div class="flex gap-2">
                        <div class="min-w-0 flex-1"><PersonCard person={person} /></div>
                      </div>
                    ) : (
                      <div class="flex items-center gap-3 rounded-xl border border-ink-700/50 bg-ink-850/40 p-3">
                        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-ink-600 bg-ink-700 font-display text-lg text-ivory-600">
                          {member.name.slice(0, 1)}
                        </span>
                        <span class="min-w-0">
                          <span class="block truncate text-sm font-semibold text-ivory-200">{member.name}</span>
                          {member.role && <span class="block truncate text-xs text-ivory-600">{member.role}</span>}
                        </span>
                      </div>
                    )}
                    {person && member.role && (
                      <p class="mt-1 truncate pl-1 text-xs text-ivory-600">as {member.role}</p>
                    )}
                  </div>
                ))}
              </div>
            )}

            {crew.length > 0 && (
              <div class="mt-8">
                {castPeople.length > 0 && <h3 class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-ivory-600">Key crew</h3>}
                <dl class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
                  {crew.map((member) => (
                    <div class="flex items-baseline justify-between gap-4 border-b border-ink-700/40 pb-2">
                      <dt class="text-sm text-ivory-500">{member.role}</dt>
                      <dd class="text-right text-sm font-medium text-ivory-200">
                        {member.slug ? (
                          <a href={`/people/${member.slug}`} class="hover:text-saffron-300">{member.name}</a>
                        ) : (
                          member.name
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </section>
        )}

        {item.summary && (
          <section class="mt-10" aria-labelledby="overview">
            <h2 id="overview" class="font-display text-2xl font-bold text-ivory-50">Overview</h2>
            <div class="prose-article mt-4 max-w-3xl">
              {item.summary.split('\n').filter(Boolean).map((para) => <p>{para}</p>)}
            </div>
          </section>
        )}

        {statTiles.length > 0 && (
          <section class="mt-10" aria-labelledby="facts">
            <h2 id="facts" class="font-display text-2xl font-bold text-ivory-50">Details at a glance</h2>
            <div class="mt-4">
              <StatTiles tiles={statTiles} />
            </div>
            <p class="mt-3 text-xs text-ivory-600">
              {item.referenceCount} cited references on Wikipedia back the facts on this page.
            </p>
          </section>
        )}

        {item.articleSections.map((section, si) => {
          const secId = `sec-${section.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
          return (
            <section class="mt-10" aria-labelledby={secId}>
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-saffron-500/30 bg-saffron-500/10 font-display text-sm font-bold text-saffron-400">
                  {String(si + 1).padStart(2, '0')}
                </span>
                <h2 id={secId} class="font-display text-2xl font-bold tracking-tight text-ivory-50">{section.title}</h2>
              </div>
              <div class="prose-article mt-4 max-w-3xl border-l-2 border-ink-700 pl-5">
                {section.text.split('\n').filter(Boolean).map((para) => <p>{para}</p>)}
              </div>
            </section>
          );
        })}

        {relatedRecords.length > 0 && (
          <section class="mt-10" aria-labelledby="related">
            <h2 id="related" class="font-display text-2xl font-bold text-ivory-50">Related titles</h2>
            <ul class="mt-4 flex flex-wrap gap-2.5">
              {relatedRecords.map((rel) => (
                <li>
                  <a href={rel.kind === 'movie' ? `/movies/${rel.slug}` : `/series/${rel.slug}`} class="focus-ring inline-block rounded-full border border-ink-600 bg-ink-800 px-4 py-2 text-sm text-ivory-300 transition hover:border-saffron-500/50 hover:text-saffron-300">
                    {rel.title} <span class="text-ivory-600">· {rel.kind === 'movie' ? 'Film' : 'Series'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {item.references.length > 0 && (
          <section class="mt-10" aria-labelledby="references">
            <h2 id="references" class="font-display text-2xl font-bold text-ivory-50">
              Sources &amp; references <span class="text-lg text-ivory-600">({item.references.length})</span>
            </h2>
            <p class="mt-2 text-sm text-ivory-500">
              Every claim on this page traces to these cited sources — follow them for the full story elsewhere.
            </p>
            <div class="mt-4">
              <ReferenceList references={item.references} />
            </div>
          </section>
        )}

        <section class="mt-10 border-t border-ink-700/60 pt-6" aria-labelledby="links">
          <h2 id="links" class="sr-only">External links and sources</h2>
          <ExternalLinks
            imdbId={item.external.imdbId}
            official={item.external.official}
            links={item.external.links}
            wikiUrl={item.wikiUrl}
            kind="title"
          />
          <p class="mt-4 text-xs leading-relaxed text-ivory-600">
            Text, metadata and images on this page derive from the Wikipedia article
            <a href={item.wikiUrl} rel="noopener" class="text-ivory-400 underline decoration-ink-500 hover:text-saffron-300">“{item.wikiTitle}”</a>,
            licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener" class="text-ivory-400 underline decoration-ink-500 hover:text-saffron-300">CC BY-SA 4.0</a>
            — see the source for its edit history and authors.
            {(item.enrichedFrom ?? []).includes('tmdb') && (
              <> Episode summaries, imagery, ratings and/or trailer data from <a href="https://www.themoviedb.org/" rel="noopener" class="text-ivory-400 underline decoration-ink-500 hover:text-saffron-300">TMDB</a>.</>
            )}
          </p>
        </section>
      </div>
    </div>
  </article>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.toggle-btn').forEach((btn) => {
    const target = btn.dataset.target ?? '';
    const show = btn.dataset.labelShow ?? 'Show all';
    const hide = btn.dataset.labelHide ?? 'Show fewer';
    let open = false;
    btn.addEventListener('click', () => {
      open = !open;
      document.querySelectorAll('.' + target).forEach((row) => row.classList.toggle('hidden', !open));
      btn.textContent = open ? hide : show;
    });
  });
</script>
