---
import type { Soundtrack } from '../../pipeline/wikitext/soundtrack.js';
import Icon from './Icon.astro';

interface Props {
  soundtrack: Soundtrack;
  /** base query for listen links, e.g. film title + composer */
  query: string;
}
const { soundtrack, query } = Astro.props;
const hasAnyMeta = soundtrack.tracks.some((t) => t.singers || t.lyrics || t.length);
const listen = (platform: string, extra = '') =>
  `${platform}${encodeURIComponent((query + ' ' + extra).trim())}`;
---

<div>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    {soundtrack.title && (
      <p class="mr-auto text-[11px] font-semibold uppercase tracking-widest text-ivory-600">
        {soundtrack.title}{soundtrack.composer ? ` · ${soundtrack.composer}` : ''}
      </p>
    )}
    <a href={listen('https://music.youtube.com/search?q=', soundtrack.composer ?? '')} rel="noopener" class="focus-ring flex items-center gap-1.5 rounded-full border border-ink-600 bg-ink-800 px-3.5 py-1.5 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
      <Icon name="music" class="h-3.5 w-3.5" /> YouTube Music
    </a>
    <a href={listen('https://open.spotify.com/search/')} rel="noopener" class="focus-ring flex items-center gap-1.5 rounded-full border border-ink-600 bg-ink-800 px-3.5 py-1.5 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
      Spotify
    </a>
    <a href={listen('https://gaana.com/search/')} rel="noopener" class="focus-ring flex items-center gap-1.5 rounded-full border border-ink-600 bg-ink-800 px-3.5 py-1.5 text-xs font-semibold text-ivory-200 transition hover:border-saffron-500/50 hover:text-saffron-300">
      Gaana
    </a>
  </div>
  <div class="overflow-hidden rounded-2xl border border-ink-700/70">
  {soundtrack.title && (
    <p class="border-b border-ink-700/70 bg-ink-800/60 px-4 py-2.5 text-[11px] font-semibold uppercase tracking-widest text-ivory-600">
      {soundtrack.title}{soundtrack.composer ? ` · ${soundtrack.composer}` : ''}
    </p>
  )}
  <table class="w-full text-sm">
    <caption class="sr-only">Track listing</caption>
    <tbody>
      {soundtrack.tracks.map((track) => (
        <tr class="border-b border-ink-700/40 last:border-0 hover:bg-ink-800/40">
          <td class="w-10 px-4 py-3 align-top font-display text-base font-bold text-saffron-400">{track.number}</td>
          <td class="px-2 py-3 align-top">
            <span class="font-semibold text-ivory-100">{track.title}</span>
            {track.singers && <span class="block text-xs text-ivory-500">{track.singers}</span>}
          </td>
          {hasAnyMeta && (
            <td class="hidden px-4 py-3 align-top text-xs text-ivory-500 md:table-cell">
              {track.lyrics ? `Lyrics: ${track.lyrics}` : ''}
            </td>
          )}
          <td class="whitespace-nowrap px-4 py-3 text-right align-top text-xs text-ivory-600">{track.length ?? ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
</div>
