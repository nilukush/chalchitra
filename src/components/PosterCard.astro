---
import type { TitleRecord } from '../../pipeline/types';
import { languageBadgeClass } from '../lib/data';

interface Props {
  item: TitleRecord;
  eager?: boolean;
}
const { item, eager = false } = Astro.props;
const href = item.kind === 'movie' ? `/movies/${item.slug}` : `/series/${item.slug}`;
---

<article>
  <a href={href} class="focus-ring group block">
    <div class="relative aspect-[2/3] overflow-hidden rounded-xl border border-ink-700/70 bg-ink-800 shadow-lg shadow-black/30 transition duration-300 group-hover:-translate-y-1 group-hover:border-saffron-500/40 group-hover:shadow-black/50">
      {item.poster ? (
        <img
          src={item.poster}
          alt={`${item.title} poster`}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="flex h-full w-full flex-col items-center justify-center gap-2 p-4 text-center grain">
          <span class="font-display text-3xl text-ivory-600">च</span>
          <span class="line-clamp-3 text-sm font-medium text-ivory-500">{item.title}</span>
        </div>
      )}
      <span class={`absolute left-2 top-2 rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset backdrop-blur-sm ${languageBadgeClass(item.language)}`}>
        {item.language}
      </span>
    </div>
    <h3 class="mt-2.5 line-clamp-2 text-[15px] font-semibold leading-snug text-ivory-100 group-hover:text-saffron-300">
      {item.title}
    </h3>
    <p class="text-xs text-ivory-600">
      {item.releaseDate ?? 'Upcoming'} · {item.kind === 'movie' ? 'Film' : 'Series'}
    </p>
  </a>
</article>
