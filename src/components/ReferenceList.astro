---
import type { ReferenceEntry } from '../../pipeline/wikitext/references.js';

interface Props {
  references: ReferenceEntry[];
}
const { references } = Astro.props;
const COLLAPSE_AFTER = 25;
const collapsed = references.length > COLLAPSE_AFTER;

// Publisher badge material: derived locally, no external preview services —
// OG/screenshot previews are a chat pattern, not an editorial one.
const hostOf = (url: string): string | null => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
};
const chipFor = (ref: ReferenceEntry): string | null => {
  const host = ref.url ? hostOf(ref.url) : null;
  const publisher = ref.source?.trim() || host;
  if (!publisher) return null;
  if (host && publisher.toLowerCase().includes(host.split('.')[0])) return host;
  return publisher;
};
---

<div>
  <ol class={`grid gap-x-8 gap-y-3 text-sm ${references.length > 12 ? 'lg:columns-2' : ''}`}>
    {references.map((ref, i) => (
      <li class={`flex gap-2.5 break-inside-avoid ${collapsed && i >= COLLAPSE_AFTER ? 'ref-overflow toggle-hidden' : ''}`}>
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-ink-700 font-display text-[11px] font-bold text-ivory-400">{i + 1}</span>
        <span class="min-w-0 leading-relaxed">
          {ref.url ? (
            <a href={ref.url} rel="noopener nofollow" class="text-ivory-100 underline decoration-ink-500 underline-offset-2 transition hover:text-saffron-300 hover:decoration-saffron-500/60">
              {ref.label}
            </a>
          ) : (
            <span class="text-ivory-100">{ref.label}</span>
          )}
          {chipFor(ref) && (
            <span class="ml-1.5 inline-flex max-w-[12rem] items-center gap-1 rounded-md border border-ink-600 bg-ink-800 px-1.5 py-0.5 align-middle text-[10px] font-semibold uppercase tracking-wider text-ivory-500">
              <span class="truncate">{chipFor(ref)}</span>
            </span>
          )}
          {ref.date && <span class="text-ivory-600"> · {ref.date}</span>}
        </span>
      </li>
    ))}
  </ol>
  {collapsed && (
    <button
      type="button"
      class="toggle-btn mt-3 rounded-full border border-ink-600 bg-ink-800 px-4 py-1.5 text-sm font-medium text-ivory-300 transition hover:border-saffron-500/50 hover:text-saffron-300"
      data-target="ref-overflow"
      data-label-show={`Show all ${references.length} references`}
      data-label-hide="Show fewer references"
    >
      Show all {references.length} references
    </button>
  )}
</div>

<script>
  // shipped with every instance of this component (person pages too)
  document.querySelectorAll<HTMLButtonElement>('.toggle-btn[data-target="ref-overflow"]').forEach((btn) => {
    const target = btn.dataset.target ?? '';
    const show = btn.dataset.labelShow ?? 'Show all';
    const hide = btn.dataset.labelHide ?? 'Show fewer';
    let open = false;
    btn.addEventListener('click', () => {
      open = !open;
      document.querySelectorAll('.' + target).forEach((row) => row.classList.toggle('toggle-hidden', !open));
      btn.textContent = open ? hide : show;
    });
  });
</script>
