---
import type { ReferenceEntry } from '../../pipeline/wikitext/references.js';

interface Props {
  references: ReferenceEntry[];
}
const { references } = Astro.props;
const COLLAPSE_AFTER = 25;
const collapsed = references.length > COLLAPSE_AFTER;
---

<div>
  <ol class={`grid gap-x-8 gap-y-1.5 text-sm ${references.length > 12 ? 'lg:columns-2' : ''}`}>
    {references.map((ref, i) => (
      <li class={`break-inside-avoid list-item pl-1 ${collapsed && i >= COLLAPSE_AFTER ? 'ref-overflow hidden' : ''}`} style="counter-increment: ref-item;">
        <span class="mr-1.5 text-xs text-ivory-600">{i + 1}.</span>
        {ref.url ? (
          <a href={ref.url} rel="noopener nofollow" class="text-ivory-200 underline decoration-ink-500 underline-offset-2 transition hover:text-saffron-300 hover:decoration-saffron-500/60">
            {ref.label}
          </a>
        ) : (
          <span class="text-ivory-200">{ref.label}</span>
        )}
        {ref.source && <span class="text-ivory-600"> — {ref.source}</span>}
        {ref.date && <span class="text-ivory-600"> · {ref.date}</span>}
      </li>
    ))}
  </ol>
  {collapsed && (
    <button
      type="button"
      class="toggle-btn mt-3 rounded-full border border-ink-600 bg-ink-800 px-4 py-1.5 text-sm font-medium text-ivory-300 transition hover:border-saffron-500/50 hover:text-saffron-300"
      data-target="ref-overflow"
      data-label-show={`Show all ${references.length} references`}
      data-label-hide="Show fewer references"
    >
      Show all {references.length} references
    </button>
  )}
</div>

<script>
  // shipped with every instance of this component (person pages too)
  document.querySelectorAll<HTMLButtonElement>('.toggle-btn[data-target="ref-overflow"]').forEach((btn) => {
    const target = btn.dataset.target ?? '';
    const show = btn.dataset.labelShow ?? 'Show all';
    const hide = btn.dataset.labelHide ?? 'Show fewer';
    let open = false;
    btn.addEventListener('click', () => {
      open = !open;
      document.querySelectorAll('.' + target).forEach((row) => row.classList.toggle('hidden', !open));
      btn.textContent = open ? hide : show;
    });
  });
</script>
